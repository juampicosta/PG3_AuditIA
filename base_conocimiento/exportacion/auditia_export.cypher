MERGE (n:AuditIA_PG2 {id: 'GL01'}) SET n:`Regla`, n = {`descripcion`: 'SI la extracción o normalización pierde o altera significado, identidad o versión (entrada_valida = falso) ENTONCES estado = no_evaluable y se registra IncidenciaEntrada; no se emiten juicios.', `descripcion_fuente`: 'PG1 §6.3', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'GL01', `localizador`: 'PG1 sección 6', `modulo`: 'global', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'GL02'}) SET n:`Regla`, n = {`descripcion`: 'SI la entrada es válida y falta un dato o referencia identificado como necesario para concluir ENTONCES el análisis afectado queda pendiente con dato_faltante; los análisis independientes continúan.', `descripcion_fuente`: 'PG1 §6.3', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'GL02', `localizador`: 'PG1 sección 6', `modulo`: 'global', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'GL03'}) SET n:`Regla`, n = {`descripcion`: 'SI llega una respuesta validada o una versión corregida vinculada a una evaluación publicada ENTONCES se crea una evaluación nueva que REEVALUA la anterior; los resultados históricos no se modifican.', `descripcion_fuente`: 'PG1 §6.3', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'GL03', `localizador`: 'PG1 sección 6', `modulo`: 'global', `version`: 'PG1-1.0'};
