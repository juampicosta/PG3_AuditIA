MERGE (n:AuditIA_PG2 {id: 'EVI-HC10'}) SET n:`Regla`, n = {`descripcion`: 'SI la información aplicable está identificada y no hay omisiones demostradas ENTONCES completitud cumple.', `descripcion_fuente`: 'PG1 §6.4', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'EVI-HC10', `localizador`: 'PG1 sección 6', `modulo`: 'evaluacion_individual', `version`: 'PG1-1.0'};
