MERGE (n:AuditIA_PG2 {id: 'PRC-HC01'}) SET n:`Regla`, n = {`descripcion`: 'SI un hallazgo deja indefinida una obligación esencial ENTONCES prioridad bloqueante, motivo sustantivo.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-HC01', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC02'}) SET n:`Regla`, n = {`descripcion`: 'SI severidad = baja y criticidad = alta (mapeo candidato activo) ENTONCES bloqueante sustantiva provisional, sin cambiar la severidad.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-HC02', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC03'}) SET n:`Regla`, n = {`descripcion`: 'SI la celda de MPR-01 es bloqueante fuera de la excepción anterior ENTONCES bloqueante sustantiva provisional.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-HC03', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC04'}) SET n:`Regla`, n = {`descripcion`: 'SI la celda es mayor, no hay bloqueo sustantivo y existe hito acordado ENTONCES prioridad mayor (en_hito).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-HC04', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC05'}) SET n:`Regla`, n = {`descripcion`: 'SI la celda es menor, el impacto es acotado y hay diferimiento aceptado ENTONCES prioridad menor (diferimiento).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-HC05', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC06'}) SET n:`Regla`, n = {`descripcion`: 'SI se identificó el dato o decisión que resolvería la observación ENTONCES formular una pregunta concreta y neutral al referente competente.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-HC06', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC07'}) SET n:`Regla`, n = {`descripcion`: 'SI dos preguntas piden el mismo dato con igual significado fundamentado ENTONCES equivalencia_semantica_confirmada = verdadero.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-HC07', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-HC08'}) SET n:`Regla`, n = {`descripcion`: 'SI hay dependencias no resueltas, brechas de cobertura o bloqueos preventivos sobre requerimientos de criticidad alta ENTONCES alerta_alcance = verdadero con motivo (candidata).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-HC08', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD01'}) SET n:`Regla`, n = {`descripcion`: 'SI la observación recibida tiene identidad, versión u origen incoherentes ENTONCES IncidenciaEntrada(ámbito = observacion_recibida) y devolución al emisor, sin prioridad.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD01', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD02'}) SET n:`Regla`, n = {`descripcion`: 'SI falta un dato confirmado como necesario para elegir el tratamiento ENTONCES prioridad bloqueante, motivo preventivo, provisional.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-RD02', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD03'}) SET n:`Regla`, n = {`descripcion`: 'SI severidad y criticidad son conocidas y el contexto es suficiente ENTONCES categoria_matriz = MPR-01(severidad, criticidad).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD03', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD04'}) SET n:`Regla`, n = {`descripcion`: 'SI la pregunta no tiene responsable ENTONCES asignacion = pendiente.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD04', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD06'}) SET n:`Regla`, n = {`descripcion`: 'SI llega una respuesta a una pregunta ENTONCES se registra con estado recibida.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD06', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD07'}) SET n:`Regla`, n = {`descripcion`: 'SI la respuesta está validada, es suficiente y no es discordante ENTONCES se deriva al módulo de origen (dispara GL03).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD07', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD08'}) SET n:`Regla`, n = {`descripcion`: 'SI dos preguntas tienen el mismo dato_clave, el mismo responsable confirmado y equivalencia semántica confirmada ENTONCES se crea una pregunta agrupada.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD08', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD09'}) SET n:`Regla`, n = {`descripcion`: 'SI la respuesta está validada, la reevaluación del origen informa resuelta, autorizada y con versión coincidente, y la revisión es conforme ENTONCES nuevo estado resuelto.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'implementada', `estado_validacion`: 'candidata', `id`: 'PRC-RD09', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD10'}) SET n:`Regla`, n = {`descripcion`: 'SI la respuesta es insuficiente o discordante ENTONCES nuevo estado pendiente_complemento.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD10', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD11'}) SET n:`Regla`, n = {`descripcion`: 'SI la revisión es conforme, el responsable está confirmado, hay prioridad y la redacción fue aceptada ENTONCES emitible = verdadero.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD11', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD12'}) SET n:`Regla`, n = {`descripcion`: 'SI una pregunta agrupa decisiones con prioridad informada ENTONCES prioridad_presentacion = máxima urgencia (bloqueante > mayor > menor).', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD12', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
MERGE (n:AuditIA_PG2 {id: 'PRC-RD13'}) SET n:`Regla`, n = {`descripcion`: 'SI todas las evaluaciones de la versión están publicadas y cada observación tiene decisión ENTONCES se genera InformeAuditoria con resúmenes y pendientes; madurez = null hasta PI3.', `descripcion_fuente`: 'PG1 §6.6', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'PRC-RD13', `localizador`: 'PG1 sección 6', `modulo`: 'priorizacion_clarificacion', `version`: 'PG1-1.0'};
