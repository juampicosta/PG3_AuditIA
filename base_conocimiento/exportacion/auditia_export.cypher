MERGE (n:AuditIA_PG2 {id: 'GL05'}) SET n:`Regla`, n = {`descripcion`: 'SI una propuesta del LLM (extracción, normalización, redacción o explicación) introduce datos no respaldados o altera una conclusión ENTONCES se rechaza y prevalece la regla.', `descripcion_fuente`: 'PG1 §6.3', `ejecucion`: 'catalogada', `estado_validacion`: 'candidata', `id`: 'GL05', `localizador`: 'PG1 sección 6', `modulo`: 'global', `version`: 'PG1-1.0'};
