# Copiar como .env. Credencial solo para el laboratorio local (no es de ninguna organización).
NEO4J_PASSWORD=auditia-pg3-2026
OLLAMA_MODEL=qwen2.5:7b
# Opcional: limitar hilos de CPU de Ollama (la corrida de PI4 usó 4)
OLLAMA_NUM_THREAD=
# Opcional: volumen de Docker que ya tiene el modelo descargado (si se deja vacío se crea uno nuevo)
OLLAMA_VOLUME=
# Opcional: modelo más chico solo para leer documentos (ej. qwen2.5:3b; hay que bajarlo con ollama pull)
OLLAMA_MODEL_INGESTA=

# Proveedor del LLM: ollama (local, por defecto) o gemini (API gratuita de Google, sin tarjeta).
# Con gemini no hace falta bajar qwen2.5:7b. Ojo: el texto de las consultas y documentos se envía a Google
# y en el plan gratuito puede usarse para mejorar sus modelos: no cargar documentos confidenciales.
LLM_PROVEEDOR=ollama
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo (por defecto gemini-flash-latest; con más cupo diario: gemini-flash-lite-latest)
GEMINI_MODEL=
# Opcional: pedidos por minuto máximos, para espaciar las llamadas y no chocar con el límite gratuito (ej. 10)
GEMINI_RPM=
